{
  "id": "driver-mock",
  "config": {
    "entries": [
      {
        "key": "subagent_count",
        "type": "int",
        "default": 3,
        "global_key": "driver.mock.subagent_count",
        "env": "TABULA_SKILL_DRIVER_MOCK_SUBAGENT_COUNT",
        "env_aliases": [
          "TABULA_MOCK_SUBAGENTS"
        ]
      },
      {
        "key": "max_turns",
        "type": "int",
        "default": 5,
        "global_key": "driver.mock.max_turns",
        "env": "TABULA_SKILL_DRIVER_MOCK_MAX_TURNS",
        "env_aliases": [
          "TABULA_MOCK_TURNS"
        ]
      },
      {
        "key": "sleep_ms",
        "type": "int",
        "default": 25,
        "global_key": "driver.mock.sleep_ms",
        "env": "TABULA_SKILL_DRIVER_MOCK_SLEEP_MS",
        "env_aliases": [
          "TABULA_MOCK_SLEEP_MS"
        ]
      },
      {
        "key": "default_waves",
        "type": "int",
        "default": 1,
        "global_key": "driver.mock.default_waves",
        "env": "TABULA_SKILL_DRIVER_MOCK_DEFAULT_WAVES",
        "env_aliases": [
          "TABULA_MOCK_WAVES"
        ]
      },
      {
        "key": "default_fanouts",
        "type": "int_list",
        "global_key": "driver.mock.default_fanouts",
        "env": "TABULA_SKILL_DRIVER_MOCK_DEFAULT_FANOUTS",
        "env_aliases": [
          "TABULA_MOCK_FANOUTS"
        ]
      }
    ]
  }
}
