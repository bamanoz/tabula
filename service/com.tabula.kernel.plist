<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tabula.kernel</string>
    <key>ProgramArguments</key>
    <array>
        <string>__TABULA_HOME__/bin/tabula</string>
        <string>serve</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>TABULA_HOME</key>
        <string>__TABULA_HOME__</string>
        <key>TABULA_BOOT</key>
        <string>__TABULA_HOME__/.venv/bin/python3 __TABULA_HOME__/boot.py</string>
        <key>TABULA_PATH</key>
        <string>__TABULA_HOME__/.venv/bin:__TABULA_HOME__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>WorkingDirectory</key>
    <string>__TABULA_HOME__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__TABULA_HOME__/logs/kernel.out.log</string>
    <key>StandardErrorPath</key>
    <string>__TABULA_HOME__/logs/kernel.err.log</string>
</dict>
</plist>
