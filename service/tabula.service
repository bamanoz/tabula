[Unit]
Description=Tabula kernel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__TABULA_HOME__
Environment=TABULA_HOME=__TABULA_HOME__
Environment=TABULA_BOOT=python3 __TABULA_HOME__/boot.py
ExecStart=__TABULA_HOME__/bin/tabula serve --foreground
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
