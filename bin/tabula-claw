#!/bin/bash
# Launch the claw interactive CLI gateway.
set -euo pipefail

TABULA_HOME="${TABULA_HOME:-$HOME/.tabula}"

if [ -f "$TABULA_HOME/.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "$TABULA_HOME/.env"
  set +a
fi

export TABULA_HOME
"${TABULA_HOME}/.venv/bin/python3" - "${TABULA_URL:-ws://localhost:8089/ws}" <<'PY'
import json
import sys
import time

import websocket

url = sys.argv[1]
deadline = time.time() + 10
last = None
while time.time() < deadline:
    try:
        ws = websocket.create_connection(url, timeout=1)
        ws.send(json.dumps({"type": "connect", "name": "tabula-claw-ready", "sends": [], "receives": [], "version": 1}))
        msg = json.loads(ws.recv())
        ws.close()
        if msg.get("type") == "connected":
            sys.exit(0)
        last = RuntimeError(str(msg))
    except Exception as exc:
        last = exc
        time.sleep(0.5)
print(f"Tabula kernel is not ready at {url}: {last}", file=sys.stderr)
print("Check $TABULA_HOME/logs/kernel.err.log and $TABULA_HOME/logs/kernel.out.log", file=sys.stderr)
sys.exit(1)
PY
exec "${TABULA_HOME}/.venv/bin/python3" "${TABULA_HOME}/clients/gateway-cli/run.py" "$@"
