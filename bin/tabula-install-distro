#!/bin/bash
set -euo pipefail

TABULA_HOME="${TABULA_HOME:-$HOME/.tabula}"
VENV_BIN="$TABULA_HOME/.venv/bin"

if [ -x "$VENV_BIN/tabula-distro" ]; then
  exec "$VENV_BIN/tabula-distro" --home "$TABULA_HOME" install "$@"
fi

# Legacy fallback for installs that haven't been re-run since tabula-distro landed.
PYTHON_BIN="$VENV_BIN/python3"
if [ ! -x "$PYTHON_BIN" ]; then
  PYTHON_BIN="python3"
fi
exec "$PYTHON_BIN" "$TABULA_HOME/bin/install-distro.py" --home "$TABULA_HOME" "$@"
