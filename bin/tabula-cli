#!/bin/bash
# Launch an additional Tabula CLI gateway session.
# Usage: tabula-cli [--driver 'command'] [--resume SESSION]
set -e

TABULA_HOME="${TABULA_HOME:-$HOME/.tabula}"
VENV_PYTHON="$TABULA_HOME/.venv/bin/python3"
TABULA_URL="${TABULA_URL:-ws://localhost:8089/ws}"

if [ ! -f "$VENV_PYTHON" ]; then
  echo "error: venv not found at $TABULA_HOME/.venv" >&2
  echo "Run install.sh first." >&2
  exit 1
fi

# Default driver from TABULA_PROVIDER
PROVIDER="${TABULA_PROVIDER:-anthropic}"
DEFAULT_DRIVER="$VENV_PYTHON skills/driver-${PROVIDER}/run.py"

# Parse arguments
DRIVER="$DEFAULT_DRIVER"
RESUME=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --driver) DRIVER="$2"; shift 2;;
    --resume) RESUME="$2"; shift 2;;
    *) echo "unknown argument: $1" >&2; exit 1;;
  esac
done

ARGS=(--driver "$DRIVER")
if [ -n "$RESUME" ]; then
  ARGS+=(--resume "$RESUME")
fi

exec "$VENV_PYTHON" "$TABULA_HOME/skills/gateway-cli/run.py" "${ARGS[@]}"
